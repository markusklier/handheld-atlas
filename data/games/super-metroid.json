      "id": "ai-supermetroiddecomp-nativer-c-android-port",
      "name": "SuperMetroidDecomp: nativer C#-Android-Port",
      "kind": "decomp",
      "release": "snes",
      "runtime": "Eigenständige Android-ARM64-App auf Basis einer C#-Übersetzung",
      "projects": [
        "supermetroiddecomp"
      ],
